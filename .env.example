# Core (legacy MIDDLEMAN_* names are still accepted)
# FORGE_HOST=127.0.0.1
# FORGE_PORT=47187
# FORGE_DATA_DIR=~/.forge
# FORGE_DEBUG=false          # Also enables extension tool-call logging
# FORGE_TELEMETRY=false      # Disable anonymous telemetry (enabled by default)
# FORGE_CORTEX_ENABLED=true  # Disable Cortex (AI self-improvement and knowledge management)
# FORGE_RUNTIME_TARGET=builder

# UI (legacy VITE_MIDDLEMAN_WS_URL and VITE_MIDDLEMAN_WS_PORT are still accepted)
# VITE_FORGE_WS_URL=ws://127.0.0.1:47187
# VITE_FORGE_WS_PORT=47187

# Skills
# BRAVE_API_KEY=
# GEMINI_API_KEY=

# Provider API-key fallbacks (Settings/shared secrets take precedence where applicable)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# CURSOR_API_KEY=

# Skill sharing (anonymous worker at https://forgeskills.radops.ai by default)
# FORGE_SKILL_SHARE_BASE_URL=https://forgeskills.radops.ai
# FORGE_SKILL_SHARE_DISABLED=false
# Legacy aliases still accepted:
# MIDDLEMAN_SKILL_SHARE_BASE_URL=https://forgeskills.radops.ai
# MIDDLEMAN_SKILL_SHARE_DISABLED=false

# Collaboration server (first boot requires admin credentials)
# Local docker-compose defaults to host port 47387 -> container port 47287.
# Persistent server data is bind-mounted at ./.forge-collaboration-data on the host.
# Optional multi-backend test service uses host port 47388, ./.forge-collaboration-data-secondary,
# and a distinct auth cookie name so both local backends can stay logged in in one browser.
# If you change FORGE_PUBLIC_PORT or FORGE_SECONDARY_PUBLIC_PORT, update the matching base URL.
# The docker-compose default trusted origins already allow local Forge UI/Electron dev on
# http://127.0.0.1:47188 and local preview on http://127.0.0.1:47189 when this variable is unset.
# Use 127.0.0.1 rather than localhost for local HTTP split deployments; mixing localhost and
# 127.0.0.1 becomes cross-site for cookies and would require HTTPS.
# FORGE_PUBLIC_PORT=47387
# FORGE_SECONDARY_PUBLIC_PORT=47388
# FORGE_ADMIN_EMAIL=admin@example.com
# FORGE_ADMIN_PASSWORD=change-me
# FORGE_COLLABORATION_BASE_URL=http://127.0.0.1:47387
# FORGE_SECONDARY_COLLABORATION_BASE_URL=http://127.0.0.1:47388
# FORGE_COLLABORATION_TRUSTED_ORIGINS=http://127.0.0.1:47188,http://127.0.0.1:47189,https://app.example.com
# FORGE_COLLABORATION_AUTH_COOKIE_NAME=forge_collab_session
# FORGE_SECONDARY_COLLABORATION_AUTH_COOKIE_NAME=forge_collab_secondary_session
# FORGE_COLLABORATION_AUTH_SECRET=
#
# Remote project working-directory allowlist (collaboration-server / remote-build only).
# Local Builder ignores this for unrestricted CWD selection.
# Delimiters: `;` and newlines always; `:` also on non-Windows (do not use `:` on Windows —
# it conflicts with drive letters like `C:\workspaces`).
# Docker should set this explicitly to a mounted workspace root such as `/workspaces`.
# Do not assume the image `/app` checkout is a user workspace. When unset on a
# collaboration server, remote list/validate/create/change CWD fail closed until configured.
# FORGE_CWD_ALLOWLIST_ROOTS=/workspaces
# Host workspace path that Docker Compose bind-mounts at /workspaces.
# FORGE_WORKSPACES_HOST_PATH=./.forge-collaboration-workspaces
#
# Optional Remote Projects deployment overrides (collaboration-server only).
# Parsed once at startup. Unset/blank = absent (API/file policy unchanged).
# Accepted booleans: 1/true/yes/on and 0/false/no/off (trim, case-insensitive).
# Invalid nonblank booleans or instance names >120 chars fail collaboration startup.
# Env wins per field over remote-build-settings.json and is never written into that file.
# instanceName is public handshake metadata; prefer a non-sensitive label.
# terminalsEnabled=false denies new member terminal mutations/tickets but does not
# close already attached terminal WebSockets. Env changes require a restart.
# FORGE_REMOTE_PROJECTS_ENABLED=
# FORGE_REMOTE_PROJECTS_TERMINALS_ENABLED=
# FORGE_REMOTE_PROJECTS_INSTANCE_NAME=

# Agent Runtimes
# OpenAI Codex Responses transport defaults to sse for reliability when unset, blank, or invalid.
# websocket-cached remains available as an explicit experimental/canary opt-in.
# Supported values: sse, websocket, websocket-cached, auto. Invalid values fail safe to sse.
# FORGE_OPENAI_CODEX_TRANSPORT=sse

# OpenAI/Codex auth source (v1 Forge Auth broker scope: OpenAI/Codex only)
# FORGE_OPENAI_CODEX_AUTH_MODE=local
# When FORGE_OPENAI_CODEX_AUTH_MODE=central_broker, Forge uses the Forge Auth broker for OpenAI/Codex.
# Env overrides are strict: saved Settings broker URL/token are ignored while the env mode is set.
# FORGE_OPENAI_AUTH_BROKER_URL=http://127.0.0.1:8787
# FORGE_OPENAI_AUTH_BROKER_TOKEN=<lease-scoped-bearer-token>
# FORGE_OPENAI_AUTH_BROKER_INSTANCE_ID=<stable-install-id>
# FORGE_OPENAI_AUTH_BROKER_INSTANCE_LABEL=<human-readable-install-label>
# Request timeout defaults to 10000 ms and is clamped to 1000-60000 ms.
# FORGE_OPENAI_AUTH_BROKER_TIMEOUT_MS=10000
# Optional: enable the sanitized /api/debug/codex-transport diagnostics endpoint.
# FORGE_CODEX_TRANSPORT_DEBUG=1

# Integrated terminal runtime (legacy MIDDLEMAN_TERMINAL_* aliases are also accepted)
# FORGE_TERMINAL_ENABLED=true
# FORGE_TERMINAL_MAX_PER_SESSION=10
# FORGE_TERMINAL_DEFAULT_COLS=120
# FORGE_TERMINAL_DEFAULT_ROWS=30
# FORGE_TERMINAL_SCROLLBACK_LINES=5000
# FORGE_TERMINAL_OUTPUT_BATCH_MS=16
# FORGE_TERMINAL_SNAPSHOT_INTERVAL_MS=30000
# FORGE_TERMINAL_JOURNAL_MAX_BYTES=1048576
# FORGE_TERMINAL_SHUTDOWN_SNAPSHOT_TIMEOUT_MS=8000
# FORGE_TERMINAL_RESTORE_STARTUP_CONCURRENCY=4
# FORGE_TERMINAL_WS_TICKET_TTL_MS=60000
# FORGE_TERMINAL_WS_MAX_BUFFERED_AMOUNT_BYTES=1048576
# Saved Settings default shell wins when both are present.
# FORGE_TERMINAL_DEFAULT_SHELL=/bin/zsh

# Electron signing / packaging examples
# macOS signing + notarization:
# APPLE_ID=developer@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=ABCDE12345
# Windows signing (optional):
# CSC_LINK=base64-or-file-path-to-pfx
# CSC_KEY_PASSWORD=your-certificate-password
# WIN_CSC_LINK=base64-or-file-path-to-pfx
# WIN_CSC_KEY_PASSWORD=your-certificate-password

# Embedded Git versioning for durable Cortex/prompt/reference file history (optional advanced settings)
# Defaults if unset:
# - FORGE_VERSIONING_ENABLED=true (legacy MIDDLEMAN_VERSIONING_ENABLED also accepted)
# - FORGE_VERSIONING_TRACK_SESSION_MEMORY=false (legacy MIDDLEMAN_VERSIONING_TRACK_SESSION_MEMORY also accepted)
# - FORGE_VERSIONING_RECONCILE_INTERVAL_MS=300000 (legacy MIDDLEMAN_VERSIONING_RECONCILE_INTERVAL_MS also accepted)
# FORGE_VERSIONING_ENABLED=true
# FORGE_VERSIONING_TRACK_SESSION_MEMORY=false
# FORGE_VERSIONING_RECONCILE_INTERVAL_MS=300000
