{
  "name": "forge",
  "version": "0.9.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.30.1",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "apps/backend",
    "apps/ui",
    "apps/electron",
    "apps/chrome-extension",
    "apps/native-messaging-host",
    "apps/stream-deck",
    "apps/skill-share-worker",
    "packages/protocol",
    "packages/cli"
  ],
  "scripts": {
    "dev:preflight": "pnpm --filter @forge/protocol build",
    "dev": "pnpm run dev:preflight && concurrently --kill-others-on-fail --names backend,ui \"pnpm --filter @forge/backend dev\" \"pnpm --filter @forge/ui dev\"",
    "dev:remote": "node scripts/dev-remote.mjs",
    "dev:backend": "pnpm run dev:preflight && pnpm --filter @forge/backend dev",
    "dev:ui": "pnpm run dev:preflight && pnpm --filter @forge/ui dev",
    "dev:electron": "node scripts/dev-electron.mjs",
    "dev:electron:remote": "node scripts/dev-electron.mjs --remote",
    "build": "pnpm --filter @forge/protocol build && pnpm --filter @forge/cli build && pnpm --filter @forge/skill-share-worker build && pnpm --filter @forge/backend build && pnpm --filter @forge/ui build && pnpm --filter @forge/stream-deck build",
    "build:electron": "pnpm --filter @forge/electron run build:all",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present run typecheck",
    "model-catalog:audit": "node scripts/model-catalog-audit.mjs",
    "pi-package:identity": "node scripts/pi-package-identity.mjs",
    "pi-extension:migrate": "node scripts/pi-extension-migration.mjs",
    "pi-upgrade:provision-0711-runner": "bash scripts/pi-upgrade/provision-pi-0711-rollback-runner.sh",
    "pi-upgrade:generate-session-fixture-manifests": "node scripts/pi-upgrade/generate-pi-session-fixture-manifests.mjs",
    "verify:dockerignore": "node scripts/verify-dockerignore-sensitive-context.mjs",
    "package:electron": "pnpm --filter @forge/electron run package",
    "streamdeck:build": "pnpm --filter @forge/stream-deck run build",
    "streamdeck:validate": "pnpm --filter @forge/stream-deck run validate",
    "streamdeck:pack": "pnpm --filter @forge/stream-deck run pack",
    "release:electron": "node -e \"console.error('Deprecated: official desktop releases must use the build-first, draft-first flow in apps/electron/README.md. This shortcut is intentionally disabled.'); process.exit(1)\"",
    "prod": "pnpm build && pnpm prod:start",
    "prod:start": "node scripts/check-data-migration.mjs && concurrently --kill-others-on-fail --names backend,ui \"cross-env NODE_ENV=production FORGE_PORT=47287 pnpm --filter @forge/backend start\" \"pnpm --filter @forge/ui preview\"",
    "prod:daemon": "node scripts/prod-daemon.mjs",
    "prod:restart": "node scripts/prod-daemon-restart.mjs",
    "test": "pnpm -r --workspace-concurrency=1 --if-present run test",
    "quality:quick": "node scripts/local-quality.mjs --tier quick",
    "quality:changed": "node scripts/local-quality.mjs --tier changed",
    "quality:full": "node scripts/local-quality.mjs --tier full",
    "quality:report": "node scripts/local-quality.mjs --tier report",
    "help:validate": "node scripts/validate-help-content.mjs --strict",
    "help:validate:migration": "node scripts/validate-help-content.mjs --strict --fidelity",
    "help:baseline": "node scripts/snapshot-help-content-baseline.mjs",
    "postinstall": "node scripts/fix-node-pty-spawn-helper-permissions.mjs"
  },
  "pnpm": {
    "overrides": {
      "zod": "^4.3.6",
      "@tanstack/router-generator>zod": "3.25.76",
      "@tanstack/router-plugin>zod": "3.25.76",
      "@tanstack/start-plugin-core>zod": "3.25.76",
      "@electron/rebuild>node-abi": "4.33.0",
      "@earendil-works/pi-ai": "0.80.6",
      "@earendil-works/pi-agent-core": "0.80.6",
      "@earendil-works/pi-coding-agent": "0.80.6",
      "@earendil-works/pi-tui": "0.80.6"
    },
    "packageExtensions": {
      "nitro-nightly@3.0.1-20260223-102354-c0b46421": {
        "dependencies": {
          "youch": "4.1.0-beta.14",
          "youch-core": "0.3.3"
        }
      }
    },
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "electron",
      "node-pty",
      "better-sqlite3",
      "sqlite3"
    ],
    "patchedDependencies": {
      "@earendil-works/pi-coding-agent@0.80.6": "patches/@earendil-works__pi-coding-agent@0.80.6.patch",
      "@earendil-works/pi-ai@0.80.6": "patches/@earendil-works__pi-ai@0.80.6.patch",
      "nitro-nightly@3.0.1-20260223-102354-c0b46421": "patches/nitro-nightly@3.0.1-20260223-102354-c0b46421.patch"
    }
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^10.2.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "knip": "^6.3.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.5"
  }
}
