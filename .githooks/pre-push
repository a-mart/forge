#!/bin/sh
set -eu

if [ "${FORGE_SKIP_LOCAL_QUALITY:-}" = "1" ]; then
  echo "FORGE_SKIP_LOCAL_QUALITY=1 set; skipping local quality pre-push hook." >&2
  exit 0
fi

should_run=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      should_run=1
      ;;
  esac
done

if [ "$should_run" -ne 1 ]; then
  exit 0
fi

echo "Protected branch push detected; running pnpm quality:changed." >&2
echo "Set FORGE_SKIP_LOCAL_QUALITY=1 to bypass this optional hook." >&2
pnpm quality:changed
