{
  "name": "@forge/electron",
  "version": "0.22.0-beta.3",
  "private": true,
  "license": "Apache-2.0",
  "description": "Forge Desktop",
  "author": {
    "name": "a-mart"
  },
  "homepage": "https://github.com/a-mart/forge",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:all": "node ./scripts/build-all.mjs",
    "prepare:dev-native": "node ./scripts/prepare-dev-native.mjs",
    "dev": "pnpm prepare:dev-native && node esbuild.config.mjs && electron .",
    "start": "pnpm prepare:dev-native && electron .",
    "pack": "pnpm build:all && electron-builder --dir",
    "package": "pnpm build:all && electron-builder --publish never",
    "dist": "pnpm run package"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/node": "^24.3.0",
    "electron": "^37.2.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9",
    "graceful-fs": "^4.2.11",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
