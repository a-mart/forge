{
  "background": {
    "service_worker": "shell/service-worker-bootstrap.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "description": "Automatic Browser bridge for operation-scoped Forge control of eligible Chrome tabs.",
  "host_permissions": [
    "<all_urls>"
  ],
  "key": "",
  "manifest_version": 3,
  "minimum_chrome_version": "125",
  "name": "Forge",
  "permissions": [
    "alarms",
    "debugger",
    "nativeMessaging",
    "scripting",
    "storage",
    "webNavigation"
  ],
  "version": "0.1.0"
}
